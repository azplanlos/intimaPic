{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "WebWorker"],
    "outDir": "./dist/sw",
    "rootDir": "./src/service-worker",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "types": []
  },
  "include": [
    "src/service-worker/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
